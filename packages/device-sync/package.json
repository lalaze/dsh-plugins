{
  "name": "dsh-device-sync",
  "version": "0.1.0",
  "description": "Pair two DSH machines over Tailscale: share workspace groups and conversation history, and steer each other's sessions",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "tailscale",
    "remote"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git",
    "directory": "packages/device-sync"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@dsh-plugins/i18n": "workspace:*",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
