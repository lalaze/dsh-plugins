{
  "name": "dsh-game-assets",
  "version": "0.3.0",
  "description": "Browse a game project's 2D art in DeepSeek Harness, see which images the code still uses and which version of each pack is live, then retire, tag, redraw them with Codex or an image API of your choice, also for the agents working in the project, or hand them to the agent",
  "type": "module",
  "icon": "icon.svg",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": { "types": "./lib/server/index.d.ts", "default": "./lib/server/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "icon.svg", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs && node scripts/build-remote.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "preview:ui": "pnpm run build && node scripts/preview.mjs",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": { "node": ">=22.15.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "game", "assets", "sprites"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lalaze/dsh-plugins.git", "directory": "packages/game-assets" },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation"]
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@dsh-plugins/i18n": "workspace:*",
    "@dsh-plugins/remote-core": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
