{
  "name": "dsh-model-groups",
  "version": "0.1.0",
  "description": "Collapsible provider groups in DeepSeek Harness's model picker",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": { "types": "./lib/server/index.d.ts", "default": "./lib/server/index.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": { "node": ">=22.15.0", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "keywords": ["dsh-plugin", "deepseek-harness", "models", "model-picker"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lalaze/dsh-plugins.git", "directory": "packages/model-groups" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-model-selection"]
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "jsdom": "^26.1.0"
  }
}
