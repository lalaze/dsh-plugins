{
  "name": "dsh-mobile",
  "version": "0.1.1",
  "description": "Read and steer this machine's DSH sessions from your phone through a relay, with end-to-end encryption, pairing by QR code and notifications",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node ../../scripts/build-client.mjs && node scripts/build-app.mjs",
    "build:app": "node scripts/build-app.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mobile",
    "relay",
    "remote"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git",
    "directory": "packages/mobile"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@dsh-plugins/i18n": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  }
}
