{
  "name": "dsh-remote-terminals",
  "version": "0.1.6",
  "description": "Terminals that outlive DSH, Claude Code and Codex TUI conversations, and worktree workspaces on the machines saved in Remote Agents",
  "type": "module",
  "main": "lib/server/index.js",
  "types": "lib/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('lib', { recursive: true, force: true })\" && tsc -p ../remote-core/tsconfig.build.json --outDir lib/server/core && tsc -p tsconfig.build.json && node ../../scripts/link-remote-core.mjs && node ../../scripts/build-client.mjs && node scripts/build-holder.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup.mjs --test --test-timeout=60000 test/*.test.ts test/*.test.tsx",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "prepack": "pnpm run build",
    "pack:plugin": "pnpm pack --pack-destination ../../dist"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "terminal",
    "tui",
    "worktree"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git",
    "directory": "packages/remote-terminals"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@dsh-plugins/i18n": "workspace:*",
    "@dsh-plugins/remote-core": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
