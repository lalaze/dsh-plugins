{
  "name": "dsh-plugins",
  "private": true,
  "description": "Independent DeepSeek Harness plugins in one workspace",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:ui": "pnpm -r --if-present run test:ui",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "pack:plugins": "pnpm -r --filter './packages/*' --filter '!@dsh-plugins/i18n' --filter '!@dsh-plugins/file-view' pack --pack-destination dist",
    "release:market": "node scripts/release-market.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalaze/dsh-plugins.git"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
